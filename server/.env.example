# Copy to server/.env and fill in. Never commit server/.env
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
CLIENT_ORIGIN=http://localhost:5173

# Login security. Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-plus-characters
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS_STUDENT=30
REFRESH_TTL_DAYS_STAFF=7

# Email (password reset, staff invites). Leave SMTP_HOST empty in development:
# emails are then printed in the server terminal instead of being sent.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<16-character Google App Password>
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=RubayOS <you@gmail.com>
# APP_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rubayos?retryWrites=true&w=majority

# Local Linux storage (used from Phase 8, development machine only)
# LOCAL_STORAGE_ROOT=/media/C/RubayOS
# LOCAL_DATABASE_BACKUP_DIR=/media/C/RubayOS/backups/database
# LOCAL_FILE_BACKUP_DIR=/media/C/RubayOS/backups/files
# LOCAL_UPLOAD_DIR=/media/C/RubayOS/uploads
# LOCAL_QUESTION_PAPERS_DIR=/media/C/RubayOS/question-papers
# LOCAL_DOCUMENTS_DIR=/media/C/RubayOS/documents
# LOCAL_TEMP_DIR=/media/C/RubayOS/temp

# --- Auth (Step 1.3) ---
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TTL_DAYS_STUDENT=30
REFRESH_TTL_DAYS_STAFF=7
COOKIE_SAMESITE=lax

# --- Email (leave SMTP_HOST empty in development: emails are printed in the server log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RubayOS <no-reply@rubayos.local>

# --- First Super Admin (used only by: npm run create-admin -w server) ---
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
