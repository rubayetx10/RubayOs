# Copy to server/.env and fill in. Never commit server/.env
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rubayos?retryWrites=true&w=majority

# Local Linux storage (used from Phase 8, development machine only)
# LOCAL_STORAGE_ROOT=/media/C/RubayOS
# LOCAL_DATABASE_BACKUP_DIR=/media/C/RubayOS/backups/database
# LOCAL_FILE_BACKUP_DIR=/media/C/RubayOS/backups/files
# LOCAL_UPLOAD_DIR=/media/C/RubayOS/uploads
# LOCAL_QUESTION_PAPERS_DIR=/media/C/RubayOS/question-papers
# LOCAL_DOCUMENTS_DIR=/media/C/RubayOS/documents
# LOCAL_TEMP_DIR=/media/C/RubayOS/temp
